# CommitIQ Environment Variables
# Copy this file to .env before starting backend or frontend services

# GitHub Integration
GITHUB_TOKEN=

# AI Model Credentials (Optional - fallbacks will be used if omitted)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Application Configuration
DATABASE_URL=sqlite+aiosqlite:///./commitiq.db
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage & Ingestion Limits
REPO_STORAGE_PATH=/tmp/commitiq_repos
MAX_REPO_STORAGE_MB=5000
MAX_COMMITS=500
LLM_BUDGET_PER_REPO_USD=0.50

# Features & Semantic Analysis
ENABLE_SEMANTIC_ANALYSIS=true
ENABLE_GRAPHCODEBERT=false

# CI / Testing
CI=true

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000
